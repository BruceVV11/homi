rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isConnectionMember(data) {
      return signedIn()
        && (data.aUid == request.auth.uid || data.bUid == request.auth.uid);
    }

    function connectionCoreUnchanged() {
      return request.resource.data.memberUids == resource.data.memberUids
        && request.resource.data.initiatorUid == resource.data.initiatorUid
        && request.resource.data.recipientUid == resource.data.recipientUid
        && request.resource.data.aUid == resource.data.aUid
        && request.resource.data.bUid == resource.data.bUid
        && request.resource.data.aName == resource.data.aName
        && request.resource.data.bName == resource.data.bName
        && request.resource.data.aPhotoUrl == resource.data.aPhotoUrl
        && request.resource.data.bPhotoUrl == resource.data.bPhotoUrl;
    }

    function hasAcceptedConnection(firstUid, secondUid) {
      let forwardId = firstUid + '_' + secondUid;
      let reverseId = secondUid + '_' + firstUid;
      let forwardPath = /databases/$(database)/documents/connections/$(forwardId);
      let reversePath = /databases/$(database)/documents/connections/$(reverseId);
      return (exists(forwardPath)
          && get(forwardPath).data.status == 'accepted'
          && firstUid in get(forwardPath).data.memberUids
          && secondUid in get(forwardPath).data.memberUids)
        || (exists(reversePath)
          && get(reversePath).data.status == 'accepted'
          && firstUid in get(reversePath).data.memberUids
          && secondUid in get(reversePath).data.memberUids);
    }

    function hasHouseholdPreference(ownerUid, otherUid) {
      let path = /databases/$(database)/documents/peoplePreferences/$(ownerUid)/people/$(otherUid);
      return exists(path) && get(path).data.scope == 'household';
    }

    function hasActiveLocationShare(ownerUid, viewerUid) {
      return hasAcceptedConnection(ownerUid, viewerUid)
        && exists(/databases/$(database)/documents/locationShares/$(ownerUid)/viewers/$(viewerUid))
        && get(/databases/$(database)/documents/locationShares/$(ownerUid)/viewers/$(viewerUid)).data.active == true;
    }

    function isSharedTaskMember(data) {
      return signedIn() && request.auth.uid in data.memberUids;
    }

    function sharedTaskCoreUnchanged() {
      return request.resource.data.memberUids == resource.data.memberUids
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.assigneeUid == resource.data.assigneeUid
        && request.resource.data.title == resource.data.title
        && request.resource.data.notes == resource.data.notes
        && request.resource.data.createdByName == resource.data.createdByName
        && request.resource.data.assigneeName == resource.data.assigneeName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.dueAt == resource.data.dueAt;
    }

    function removesSelfFromSharedTask() {
      return signedIn()
        && request.auth.uid in resource.data.memberUids
        && resource.data.createdByUid != request.auth.uid
        && !(request.auth.uid in request.resource.data.memberUids)
        && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
        && request.resource.data.memberUids.hasOnly(resource.data.memberUids)
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.title == resource.data.title
        && request.resource.data.notes == resource.data.notes
        && request.resource.data.createdByName == resource.data.createdByName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.dueAt == resource.data.dueAt
        && (
          resource.data.assigneeUid == request.auth.uid
            ? request.resource.data.assigneeUid == null
              && request.resource.data.assigneeName == 'Unassigned'
            : request.resource.data.assigneeUid == resource.data.assigneeUid
              && request.resource.data.assigneeName == resource.data.assigneeName
        )
        && (
          resource.data.completedByUid == request.auth.uid
            ? request.resource.data.completedByUid == null
              && request.resource.data.completedByName == 'Former Homi user'
            : request.resource.data.completedByUid == resource.data.completedByUid
              && request.resource.data.completedByName == resource.data.completedByName
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'memberUids',
          'assigneeUid',
          'assigneeName',
          'completedByUid',
          'completedByName',
          'updatedAt'
        ]);
    }

    match /users/{uid} {
      allow read, create, update, delete: if isSelf(uid);

      match /devices/{deviceId} {
        allow read, create, update, delete: if isSelf(uid);
      }
    }

    // Homi codes are authenticated exact-lookups only. They are not a
    // browseable people directory.
    match /homiCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid;
    }

    // aUid/bUid are deterministic participant fields. The client uses one
    // equality query for each field and merges the results. This gives the
    // rules engine a query shape it can prove without exposing other users'
    // connection documents.
    match /connections/{connectionId} {
      allow get, list: if isConnectionMember(resource.data);

      allow create: if signedIn()
        && request.resource.data.status == 'pending'
        && request.resource.data.initiatorUid == request.auth.uid
        && request.resource.data.recipientUid != request.auth.uid
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() == 2
        && request.resource.data.initiatorUid in request.resource.data.memberUids
        && request.resource.data.recipientUid in request.resource.data.memberUids
        && request.resource.data.aUid in request.resource.data.memberUids
        && request.resource.data.bUid in request.resource.data.memberUids
        && request.resource.data.aUid != request.resource.data.bUid;

      allow update: if signedIn()
        && resource.data.status == 'pending'
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.status == 'accepted'
        && connectionCoreUnchanged();

      allow delete: if isConnectionMember(resource.data);
    }

    // Relationship labels and household-vs-friend scope are private to the
    // owner. A person may delete a preference document whose subject is their
    // own account during account deletion, but cannot read or edit its label.
    match /peoplePreferences/{ownerUid}/people/{otherUid} {
      allow read, create, update: if isSelf(ownerUid);
      allow delete: if isSelf(ownerUid) || isSelf(otherUid);
    }

    // Household tasks carry an explicit memberUids visibility list. Personal
    // tasks assigned to the creator remain local-only and never enter here.
    match /sharedTasks/{taskId} {
      allow get, list: if isSharedTaskMember(resource.data);

      allow create: if signedIn()
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() >= 2
        && request.resource.data.memberUids.size() <= 20
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdByUid in request.resource.data.memberUids
        && (
          request.resource.data.assigneeUid == null
          || (
            request.resource.data.assigneeUid != request.auth.uid
            && request.resource.data.assigneeUid in request.resource.data.memberUids
            && hasAcceptedConnection(
              request.resource.data.createdByUid,
              request.resource.data.assigneeUid
            )
            && hasHouseholdPreference(
              request.resource.data.createdByUid,
              request.resource.data.assigneeUid
            )
          )
        );

      allow update: if (isSharedTaskMember(resource.data)
          && sharedTaskCoreUnchanged())
        || removesSelfFromSharedTask();

      allow delete: if isSharedTaskMember(resource.data);
    }

    match /locationShares/{ownerUid}/viewers/{viewerUid} {
      allow read: if isSelf(ownerUid) || isSelf(viewerUid);
      allow create, update: if isSelf(ownerUid)
        && request.resource.data.ownerUid == ownerUid
        && request.resource.data.viewerUid == viewerUid
        && hasAcceptedConnection(ownerUid, viewerUid);
      // The viewer may remove their own access record during account deletion.
      allow delete: if isSelf(ownerUid) || isSelf(viewerUid);
    }

    // Homi stores only the latest shared location/battery snapshot here.
    // Movement history is deliberately not enabled by default.
    match /locations/{ownerUid} {
      allow create, update, delete: if isSelf(ownerUid);
      allow read: if isSelf(ownerUid)
        || (signedIn() && hasActiveLocationShare(ownerUid, request.auth.uid));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
