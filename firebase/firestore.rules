rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isDeveloperAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/developerAdmins/$(request.auth.uid))
        && get(/databases/$(database)/documents/developerAdmins/$(request.auth.uid)).data.active == true;
    }

    function isConnectionMember(data) {
      return signedIn()
        && (data.aUid == request.auth.uid || data.bUid == request.auth.uid);
    }

    function hasAcceptedConnection(firstUid, secondUid) {
      let forwardId = firstUid + '_' + secondUid;
      let reverseId = secondUid + '_' + firstUid;
      let forwardPath = /databases/$(database)/documents/connections/$(forwardId);
      let reversePath = /databases/$(database)/documents/connections/$(reverseId);
      return (exists(forwardPath)
          && get(forwardPath).data.status == 'accepted'
          && get(forwardPath).data.aUid == firstUid
          && get(forwardPath).data.bUid == secondUid)
        || (exists(reversePath)
          && get(reversePath).data.status == 'accepted'
          && get(reversePath).data.aUid == secondUid
          && get(reversePath).data.bUid == firstUid);
    }

    function hasActiveLocationShare(ownerUid, viewerUid) {
      return hasAcceptedConnection(ownerUid, viewerUid)
        && exists(/databases/$(database)/documents/locationShares/$(ownerUid)/viewers/$(viewerUid))
        && get(/databases/$(database)/documents/locationShares/$(ownerUid)/viewers/$(viewerUid)).data.active == true;
    }

    function isSharedTaskMember(data) {
      return signedIn()
        && data.memberUids.hasAny([request.auth.uid]);
    }

    function myHouseholdMembership(householdId) {
      let membershipPath = /databases/$(database)/documents/householdMemberships/$(request.auth.uid);
      return signedIn()
        && exists(membershipPath)
        && get(membershipPath).data.householdId == householdId;
    }

    function isCanonicalHouseholdMember(householdId) {
      let householdPath = /databases/$(database)/documents/households/$(householdId);
      return myHouseholdMembership(householdId)
        && exists(householdPath)
        && get(householdPath).data.memberUids is list
        && get(householdPath).data.memberUids.hasAny([request.auth.uid]);
    }

    function isHouseholdOwner(householdId) {
      let membershipPath = /databases/$(database)/documents/householdMemberships/$(request.auth.uid);
      let householdPath = /databases/$(database)/documents/households/$(householdId);
      return myHouseholdMembership(householdId)
        && get(membershipPath).data.role == 'owner'
        && exists(householdPath)
        && get(householdPath).data.ownerUid == request.auth.uid;
    }

    function validHouseholdDataRecord(recordId, data) {
      return data.keys().hasOnly([
          'domain',
          'itemId',
          'payload',
          'schemaVersion',
          'updatedByUid',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'domain',
          'itemId',
          'payload',
          'schemaVersion',
          'updatedByUid',
          'updatedAt'
        ])
        && data.domain in [
          'routine',
          'supply',
          'homeThing',
          'homeEvent',
          'utilityReading'
        ]
        && data.itemId is string
        && data.itemId.size() > 0
        && data.itemId.size() <= 128
        && recordId == data.domain + '--' + data.itemId
        && data.payload is map
        && data.payload.id == data.itemId
        && data.schemaVersion == 1
        && data.updatedByUid == request.auth.uid
        && data.updatedAt == request.time;
    }

    function validLocationSnapshot(data) {
      return data.keys().hasOnly([
          'latitude',
          'longitude',
          'accuracyMeters',
          'batteryPercent',
          'isCharging',
          'updatedAt',
          'source'
        ])
        && data.keys().hasAll([
          'latitude',
          'longitude',
          'accuracyMeters',
          'batteryPercent',
          'isCharging',
          'updatedAt',
          'source'
        ])
        && data.latitude is number
        && data.latitude >= -90
        && data.latitude <= 90
        && data.longitude is number
        && data.longitude >= -180
        && data.longitude <= 180
        && data.accuracyMeters is number
        && data.accuracyMeters >= 0
        && data.accuracyMeters <= 100000
        && data.batteryPercent is int
        && data.batteryPercent >= 0
        && data.batteryPercent <= 100
        && data.isCharging is bool
        && data.updatedAt == request.time
        && data.source in [
          'foreground_refresh',
          'continuous_foreground_service',
          'continuous_start'
        ];
    }

    // Homi profile identity and push registrations are provisioned by
    // App-Check-protected Functions. The mobile client can read only its own
    // profile/device records and cannot manufacture arbitrary registrations.
    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create, update, delete: if false;

      match /devices/{deviceId} {
        allow read: if isSelf(uid);
        allow create, update, delete: if false;
      }
    }

    match /developerAdmins/{uid} {
      allow get: if isSelf(uid);
      allow list, create, update, delete: if false;
    }

    match /notificationCampaigns/{campaignId} {
      allow read: if isDeveloperAdmin();
      allow create, update, delete: if false;
    }

    match /heartCooldowns/{documentId} {
      allow read, write: if false;
    }
    match /serverRateLimits/{documentId} {
      allow read, write: if false;
    }

    match /homiCodes/{code} {
      allow read, write: if false;
    }

    match /connections/{connectionId} {
      allow get, list: if isConnectionMember(resource.data);
      allow create, update, delete: if false;
    }

    match /peoplePreferences/{ownerUid}/people/{otherUid} {
      allow read: if isSelf(ownerUid);
      allow create, update, delete: if false;
    }

    match /sharedTasks/{taskId} {
      allow get, list: if isSharedTaskMember(resource.data);
      allow create, update, delete: if false;
    }

    // Canonical Household identity is server-managed. A user may read the one
    // membership record belonging to their account, but cannot enumerate or
    // mutate membership documents directly.
    match /householdMemberships/{uid} {
      allow get: if isSelf(uid);
      allow list, create, update, delete: if false;
    }

    // Household documents are server-managed. Direct document reads retain the
    // canonical membership-pointer check. Collection queries use the same
    // membership predicate already proven for sharedTasks; adding a separate
    // query-time type predicate prevents Firestore from proving the list query.
    match /households/{householdId} {
      allow get: if signedIn()
        && resource.data.memberUids is list
        && resource.data.memberUids.hasAny([request.auth.uid])
        && myHouseholdMembership(householdId);
      allow list: if signedIn()
        && resource.data.memberUids.hasAny([request.auth.uid]);
      allow create, update, delete: if false;

      match /members/{memberUid} {
        allow get, list: if myHouseholdMembership(householdId);
        allow create, update, delete: if false;
      }

      // 0.12 shared Household records are deliberately nested under the exact
      // canonical Household. Members can read and make local-first writes only
      // while both their membership pointer and Household member list agree.
      // The outer envelope is fixed so clients cannot forge actor/timestamp,
      // record identity or an unreviewed data domain. Domain payloads remain
      // versioned application records and are bounded by Firestore's document
      // limit.
      match /data/{recordId} {
        allow read: if isCanonicalHouseholdMember(householdId);
        allow create, update: if isCanonicalHouseholdMember(householdId)
          && validHouseholdDataRecord(recordId, request.resource.data);
        allow delete: if isCanonicalHouseholdMember(householdId);
      }
    }

    // Invitees can read invitations addressed to them. Direct owner reads keep
    // the canonical owner check. Collection queries use the server-owned
    // inviterUid field so the app's incoming/outgoing filtered queries can be
    // proven safe by Firestore without allowing unfiltered enumeration.
    match /householdInvites/{inviteId} {
      allow get: if signedIn()
        && (resource.data.inviteeUid == request.auth.uid
          || (resource.data.inviterUid == request.auth.uid
            && isHouseholdOwner(resource.data.householdId)));
      allow list: if signedIn()
        && (resource.data.inviteeUid == request.auth.uid
          || resource.data.inviterUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /locationShares/{ownerUid}/viewers/{viewerUid} {
      allow read: if isSelf(ownerUid) || isSelf(viewerUid);
      allow create, update, delete: if false;
    }

    // A saved Home/Work coordinate is more sensitive than a normal connection.
    // Another person may read one exact document only when the owner explicitly
    // included them in viewerUids AND still actively shares live/latest location
    // with them. Clients cannot create or mutate this collection directly.
    match /sharedPlaces/{ownerUid}/places/{kind} {
      allow get: if isSelf(ownerUid)
        || (signedIn()
          && resource.data.ownerUid == ownerUid
          && resource.data.kind == kind
          && resource.data.viewerUids is list
          && resource.data.viewerUids.hasAny([request.auth.uid])
          && hasActiveLocationShare(ownerUid, request.auth.uid));
      allow list, create, update, delete: if false;
    }

    // Latest location is the only high-frequency collaboration state written
    // directly from the device. Owner/schema checks plus a 90-second minimum
    // update interval provide a cost-abuse backstop even before service-level
    // App Check enforcement is switched on for production.
    match /locations/{ownerUid} {
      allow create: if isSelf(ownerUid)
        && validLocationSnapshot(request.resource.data);
      allow update: if isSelf(ownerUid)
        && validLocationSnapshot(request.resource.data)
        && request.time >= resource.data.updatedAt + duration.value(90, 's');
      allow delete: if false;
      allow read: if isSelf(ownerUid)
        || (signedIn() && hasActiveLocationShare(ownerUid, request.auth.uid));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
