rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isDeveloperAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/developerAdmins/$(request.auth.uid))
        && get(/databases/$(database)/documents/developerAdmins/$(request.auth.uid)).data.active == true;
    }

    function isConnectionMember(data) {
      return signedIn()
        && (data.aUid == request.auth.uid || data.bUid == request.auth.uid);
    }

    function hasAcceptedConnection(firstUid, secondUid) {
      let ids = firstUid < secondUid
        ? [firstUid, secondUid]
        : [secondUid, firstUid];
      let path = /databases/$(database)/documents/connections/$(ids[0] + '_' + ids[1]);
      return exists(path)
        && get(path).data.status == 'accepted'
        && get(path).data.aUid == ids[0]
        && get(path).data.bUid == ids[1];
    }

    function hasActiveLocationShare(ownerUid, viewerUid) {
      return hasAcceptedConnection(ownerUid, viewerUid)
        && exists(/databases/$(database)/documents/locationShares/$(ownerUid)/viewers/$(viewerUid))
        && get(/databases/$(database)/documents/locationShares/$(ownerUid)/viewers/$(viewerUid)).data.active == true;
    }

    function isSharedTaskMember(data) {
      return signedIn()
        && data.memberUids is list
        && request.auth.uid in data.memberUids;
    }

    function validDeviceRegistration(data) {
      return data.keys().hasOnly([
          'pushToken',
          'platform',
          'notificationsEnabled',
          'householdAttention',
          'tasksAndRoutines',
          'peopleNotifications',
          'homiUpdates',
          'serviceNotices',
          'updatedAt'
        ])
        && data.notificationsEnabled is bool
        && (!('pushToken' in data)
          || (data.pushToken is string && data.pushToken.size() <= 4096))
        && (!('platform' in data)
          || (data.platform is string && data.platform.size() <= 32))
        && (!('householdAttention' in data) || data.householdAttention is bool)
        && (!('tasksAndRoutines' in data) || data.tasksAndRoutines is bool)
        && (!('peopleNotifications' in data) || data.peopleNotifications is bool)
        && (!('homiUpdates' in data) || data.homiUpdates is bool)
        && (!('serviceNotices' in data) || data.serviceNotices is bool)
        && data.updatedAt == request.time;
    }

    function validLocationSnapshot(data) {
      return data.keys().hasOnly([
          'latitude',
          'longitude',
          'accuracyMeters',
          'batteryPercent',
          'isCharging',
          'updatedAt',
          'source'
        ])
        && data.keys().hasAll([
          'latitude',
          'longitude',
          'accuracyMeters',
          'batteryPercent',
          'isCharging',
          'updatedAt',
          'source'
        ])
        && data.latitude is number
        && data.latitude >= -90
        && data.latitude <= 90
        && data.longitude is number
        && data.longitude >= -180
        && data.longitude <= 180
        && data.accuracyMeters is number
        && data.accuracyMeters >= 0
        && data.accuracyMeters <= 100000
        && data.batteryPercent is int
        && data.batteryPercent >= 0
        && data.batteryPercent <= 100
        && data.isCharging is bool
        && data.updatedAt == request.time
        && data.source in [
          'foreground_refresh',
          'continuous_foreground_service',
          'continuous_start'
        ];
    }

    // Profile identity is provisioned by App-Check-protected Cloud Functions.
    // The mobile client can read only its own profile. Keeping writes server-only
    // prevents code/profile spoofing and makes Homi code ownership atomic.
    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create, update, delete: if false;

      // Device push registration remains a direct owner write because FCM token
      // refresh is device-local. Schema validation limits what it can contain.
      // Firestore App Check enforcement is the production abuse boundary for
      // this direct path.
      match /devices/{deviceId} {
        allow read, delete: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && deviceId.size() > 0
          && deviceId.size() <= 128
          && validDeviceRegistration(request.resource.data);
      }
    }

    match /developerAdmins/{uid} {
      allow get: if isSelf(uid);
      allow list, create, update, delete: if false;
    }

    // Campaign creation is server-only through queueDeveloperNotification.
    match /notificationCampaigns/{campaignId} {
      allow read: if isDeveloperAdmin();
      allow create, update, delete: if false;
    }

    // Server-only control-plane collections.
    match /heartCooldowns/{documentId} {
      allow read, write: if false;
    }
    match /serverRateLimits/{documentId} {
      allow read, write: if false;
    }

    // Codes are deliberately not readable from Firestore. Exact lookup and
    // issuance happen through rate-limited, App-Check-protected callables.
    match /homiCodes/{code} {
      allow read, write: if false;
    }

    // Clients can observe only connections they participate in. Every mutation
    // is server-authorised so status transitions and cleanup are atomic.
    match /connections/{connectionId} {
      allow get, list: if isConnectionMember(resource.data);
      allow create, update, delete: if false;
    }

    match /peoplePreferences/{ownerUid}/people/{otherUid} {
      allow read: if isSelf(ownerUid);
      allow create, update, delete: if false;
    }

    // Task membership is derived server-side from accepted Household
    // relationships; clients cannot forge member lists, completion actors or
    // purge timing.
    match /sharedTasks/{taskId} {
      allow get, list: if isSharedTaskMember(resource.data);
      allow create, update, delete: if false;
    }

    // Share state is readable only by the owner/viewer pair and mutated through
    // setLocationShare. Disconnect cleanup therefore cannot leave a client-
    // writable stale authorization behind.
    match /locationShares/{ownerUid}/viewers/{viewerUid} {
      allow read: if isSelf(ownerUid) || isSelf(viewerUid);
      allow create, update, delete: if false;
    }

    // Latest location is the only high-frequency direct collaboration write.
    // It remains owner-only and schema constrained. Production Firestore App
    // Check enforcement is required before public release.
    match /locations/{ownerUid} {
      allow create, update: if isSelf(ownerUid)
        && validLocationSnapshot(request.resource.data);
      allow delete: if false;
      allow read: if isSelf(ownerUid)
        || (signedIn() && hasActiveLocationShare(ownerUid, request.auth.uid));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
