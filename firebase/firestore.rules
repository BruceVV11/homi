rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function shortString(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function optionalString(value, maxLength) {
      return value == null || (value is string && value.size() <= maxLength);
    }

    function isDeveloperAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/developerAdmins/$(request.auth.uid))
        && get(/databases/$(database)/documents/developerAdmins/$(request.auth.uid)).data.active == true;
    }

    function isConnectionMember(data) {
      return signedIn()
        && (data.aUid == request.auth.uid || data.bUid == request.auth.uid);
    }

    function connectionCoreUnchanged() {
      return request.resource.data.memberUids == resource.data.memberUids
        && request.resource.data.initiatorUid == resource.data.initiatorUid
        && request.resource.data.recipientUid == resource.data.recipientUid
        && request.resource.data.aUid == resource.data.aUid
        && request.resource.data.bUid == resource.data.bUid
        && request.resource.data.aName == resource.data.aName
        && request.resource.data.bName == resource.data.bName
        && request.resource.data.aPhotoUrl == resource.data.aPhotoUrl
        && request.resource.data.bPhotoUrl == resource.data.bPhotoUrl
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function hasAcceptedConnection(firstUid, secondUid) {
      let forwardId = firstUid + '_' + secondUid;
      let reverseId = secondUid + '_' + firstUid;
      let forwardPath = /databases/$(database)/documents/connections/$(forwardId);
      let reversePath = /databases/$(database)/documents/connections/$(reverseId);
      return (exists(forwardPath)
          && get(forwardPath).data.status == 'accepted'
          && firstUid in get(forwardPath).data.memberUids
          && secondUid in get(forwardPath).data.memberUids)
        || (exists(reversePath)
          && get(reversePath).data.status == 'accepted'
          && firstUid in get(reversePath).data.memberUids
          && secondUid in get(reversePath).data.memberUids);
    }

    function hasHouseholdPreference(ownerUid, otherUid) {
      let path = /databases/$(database)/documents/peoplePreferences/$(ownerUid)/people/$(otherUid);
      return exists(path) && get(path).data.scope == 'household';
    }

    function hasActiveLocationShare(ownerUid, viewerUid) {
      return hasAcceptedConnection(ownerUid, viewerUid)
        && exists(/databases/$(database)/documents/locationShares/$(ownerUid)/viewers/$(viewerUid))
        && get(/databases/$(database)/documents/locationShares/$(ownerUid)/viewers/$(viewerUid)).data.active == true;
    }

    function isSharedTaskMember(data) {
      return signedIn() && request.auth.uid in data.memberUids;
    }

    function sharedTaskCoreUnchanged() {
      return request.resource.data.memberUids == resource.data.memberUids
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.assigneeUid == resource.data.assigneeUid
        && request.resource.data.title == resource.data.title
        && request.resource.data.notes == resource.data.notes
        && request.resource.data.createdByName == resource.data.createdByName
        && request.resource.data.assigneeName == resource.data.assigneeName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.dueAt == resource.data.dueAt;
    }

    function validSharedTaskCompletionUpdate() {
      return isSharedTaskMember(resource.data)
        && sharedTaskCoreUnchanged()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'completedAt',
          'completedByName',
          'completedByUid',
          'purgeAt',
          'updatedAt'
        ])
        && (
          (
            request.resource.data.completedAt == null
            && request.resource.data.completedByUid == null
            && request.resource.data.completedByName == null
            && request.resource.data.purgeAt == null
          )
          || (
            request.resource.data.completedAt is timestamp
            && request.resource.data.completedByUid == request.auth.uid
            && shortString(request.resource.data.completedByName, 80)
            && request.resource.data.purgeAt is timestamp
            && request.resource.data.purgeAt > request.resource.data.completedAt
          )
        );
    }

    function removesSelfFromSharedTask() {
      return signedIn()
        && request.auth.uid in resource.data.memberUids
        && resource.data.createdByUid != request.auth.uid
        && !(request.auth.uid in request.resource.data.memberUids)
        && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
        && request.resource.data.memberUids.hasOnly(resource.data.memberUids)
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.title == resource.data.title
        && request.resource.data.notes == resource.data.notes
        && request.resource.data.createdByName == resource.data.createdByName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.dueAt == resource.data.dueAt
        && (
          resource.data.assigneeUid == request.auth.uid
            ? request.resource.data.assigneeUid == null
              && request.resource.data.assigneeName == 'Unassigned'
            : request.resource.data.assigneeUid == resource.data.assigneeUid
              && request.resource.data.assigneeName == resource.data.assigneeName
        )
        && (
          resource.data.completedByUid == request.auth.uid
            ? request.resource.data.completedByUid == null
              && request.resource.data.completedByName == 'Former Homi user'
            : request.resource.data.completedByUid == resource.data.completedByUid
              && request.resource.data.completedByName == resource.data.completedByName
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'memberUids',
          'assigneeUid',
          'assigneeName',
          'completedByUid',
          'completedByName',
          'updatedAt'
        ]);
    }

    function validDeviceRegistration(data) {
      return data.keys().hasOnly([
          'pushToken',
          'platform',
          'notificationsEnabled',
          'householdAttention',
          'tasksAndRoutines',
          'peopleNotifications',
          'homiUpdates',
          'serviceNotices',
          'updatedAt'
        ])
        && data.notificationsEnabled is bool
        && (!('pushToken' in data)
          || (data.pushToken is string && data.pushToken.size() <= 4096))
        && (!('platform' in data)
          || (data.platform is string && data.platform.size() <= 32))
        && (!('householdAttention' in data) || data.householdAttention is bool)
        && (!('tasksAndRoutines' in data) || data.tasksAndRoutines is bool)
        && (!('peopleNotifications' in data) || data.peopleNotifications is bool)
        && (!('homiUpdates' in data) || data.homiUpdates is bool)
        && (!('serviceNotices' in data) || data.serviceNotices is bool);
    }

    function validLocationSnapshot(data) {
      return data.keys().hasOnly([
          'latitude',
          'longitude',
          'accuracyMeters',
          'batteryPercent',
          'isCharging',
          'updatedAt',
          'source'
        ])
        && data.keys().hasAll([
          'latitude',
          'longitude',
          'accuracyMeters',
          'batteryPercent',
          'isCharging',
          'updatedAt',
          'source'
        ])
        && data.latitude >= -90
        && data.latitude <= 90
        && data.longitude >= -180
        && data.longitude <= 180
        && data.accuracyMeters >= 0
        && data.accuracyMeters <= 100000
        && data.batteryPercent is int
        && data.batteryPercent >= 0
        && data.batteryPercent <= 100
        && data.isCharging is bool
        && data.updatedAt == request.time
        && data.source in [
          'foreground_refresh',
          'continuous_foreground_service',
          'continuous_start'
        ];
    }

    match /users/{uid} {
      allow read, create, update, delete: if isSelf(uid);

      match /devices/{deviceId} {
        allow read, delete: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && deviceId.size() <= 128
          && validDeviceRegistration(request.resource.data);
      }
    }

    // Developer access is provisioned outside the app. A signed-in user may
    // only inspect their own record so Homi can decide whether to show the
    // developer notification centre.
    match /developerAdmins/{uid} {
      allow get: if isSelf(uid);
      allow list, create, update, delete: if false;
    }

    // Developers may queue a narrowly validated campaign. Delivery state is
    // written only by the Admin SDK in Cloud Functions, which bypasses client
    // rules. No user can grant themselves developer access from the app.
    match /notificationCampaigns/{campaignId} {
      allow read: if isDeveloperAdmin();
      allow create: if isDeveloperAdmin()
        && request.resource.data.keys().hasOnly([
          'title',
          'body',
          'category',
          'route',
          'audience',
          'priority',
          'createdByUid',
          'status',
          'createdAt'
        ])
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.status == 'queued'
        && shortString(request.resource.data.title, 80)
        && shortString(request.resource.data.body, 280)
        && request.resource.data.category in ['update', 'service', 'security']
        && request.resource.data.route in [
          'overview', 'tasks', 'routines', 'home', 'supplies', 'people', 'account'
        ]
        && request.resource.data.audience in ['self', 'all']
        && request.resource.data.priority in ['normal', 'important']
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Server-only anti-spam/rate-limit state.
    match /heartCooldowns/{documentId} {
      allow read, write: if false;
    }
    match /serverRateLimits/{documentId} {
      allow read, write: if false;
    }

    // Homi codes are authenticated exact-lookups only. They are not a
    // browseable people directory. Writes are limited to the owner's own
    // compact identity record.
    match /homiCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && code.size() == 6
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'photoUrl', 'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && shortString(request.resource.data.displayName, 80)
        && optionalString(request.resource.data.photoUrl, 1000)
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && code.size() == 6
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'photoUrl', 'updatedAt'
        ])
        && shortString(request.resource.data.displayName, 80)
        && optionalString(request.resource.data.photoUrl, 1000)
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid;
    }

    // aUid/bUid are deterministic participant fields. The client uses one
    // equality query for each field and merges the results. The document ID
    // must match those participant fields so callers cannot create unlimited
    // duplicate request documents for the same ordered pair.
    match /connections/{connectionId} {
      allow get, list: if isConnectionMember(resource.data);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'memberUids',
          'initiatorUid',
          'recipientUid',
          'status',
          'aUid',
          'aName',
          'aPhotoUrl',
          'bUid',
          'bName',
          'bPhotoUrl',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.status == 'pending'
        && request.resource.data.initiatorUid == request.auth.uid
        && request.resource.data.recipientUid != request.auth.uid
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() == 2
        && request.resource.data.memberUids[0] == request.resource.data.aUid
        && request.resource.data.memberUids[1] == request.resource.data.bUid
        && request.resource.data.initiatorUid in request.resource.data.memberUids
        && request.resource.data.recipientUid in request.resource.data.memberUids
        && request.resource.data.aUid != request.resource.data.bUid
        && connectionId == request.resource.data.aUid + '_' + request.resource.data.bUid
        && shortString(request.resource.data.aName, 80)
        && shortString(request.resource.data.bName, 80)
        && optionalString(request.resource.data.aPhotoUrl, 1000)
        && optionalString(request.resource.data.bPhotoUrl, 1000)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if signedIn()
        && resource.data.status == 'pending'
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.status == 'accepted'
        && connectionCoreUnchanged()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'acceptedAt', 'updatedAt'
        ])
        && request.resource.data.acceptedAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow delete: if isConnectionMember(resource.data);
    }

    // Relationship labels and household-vs-friend scope are private to the
    // owner and may only exist for an accepted trusted connection.
    match /peoplePreferences/{ownerUid}/people/{otherUid} {
      allow read: if isSelf(ownerUid);
      allow create, update: if isSelf(ownerUid)
        && ownerUid != otherUid
        && hasAcceptedConnection(ownerUid, otherUid)
        && request.resource.data.keys().hasOnly([
          'relationship', 'scope', 'updatedAt'
        ])
        && shortString(request.resource.data.relationship, 40)
        && request.resource.data.scope in ['household', 'friend']
        && request.resource.data.updatedAt == request.time;
      allow delete: if isSelf(ownerUid) || isSelf(otherUid);
    }

    // Household tasks carry an explicit memberUids visibility list. Personal
    // tasks assigned to the creator remain local-only and never enter here.
    match /sharedTasks/{taskId} {
      allow get, list: if isSharedTaskMember(resource.data);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'title',
          'notes',
          'assigneeUid',
          'assigneeName',
          'createdByUid',
          'createdByName',
          'memberUids',
          'createdAt',
          'dueAt',
          'completedAt',
          'completedByName',
          'completedByUid',
          'purgeAt'
        ])
        && shortString(request.resource.data.title, 120)
        && optionalString(request.resource.data.notes, 1000)
        && shortString(request.resource.data.createdByName, 80)
        && optionalString(request.resource.data.assigneeName, 80)
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() >= 2
        && request.resource.data.memberUids.size() <= 20
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdByUid in request.resource.data.memberUids
        && request.resource.data.createdAt == request.time
        && request.resource.data.completedAt == null
        && request.resource.data.completedByName == null
        && request.resource.data.completedByUid == null
        && request.resource.data.purgeAt == null
        && (
          request.resource.data.assigneeUid == null
          || (
            request.resource.data.assigneeUid != request.auth.uid
            && request.resource.data.assigneeUid in request.resource.data.memberUids
            && hasAcceptedConnection(
              request.resource.data.createdByUid,
              request.resource.data.assigneeUid
            )
            && hasHouseholdPreference(
              request.resource.data.createdByUid,
              request.resource.data.assigneeUid
            )
          )
        );

      allow update: if validSharedTaskCompletionUpdate()
        || removesSelfFromSharedTask();

      allow delete: if isSharedTaskMember(resource.data)
        && (
          resource.data.createdByUid == request.auth.uid
          || (
            resource.data.purgeAt is timestamp
            && resource.data.purgeAt <= request.time
          )
        );
    }

    match /locationShares/{ownerUid}/viewers/{viewerUid} {
      allow read: if isSelf(ownerUid) || isSelf(viewerUid);
      allow create, update: if isSelf(ownerUid)
        && ownerUid != viewerUid
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'viewerUid', 'active', 'updatedAt'
        ])
        && request.resource.data.ownerUid == ownerUid
        && request.resource.data.viewerUid == viewerUid
        && request.resource.data.active is bool
        && request.resource.data.updatedAt == request.time
        && hasAcceptedConnection(ownerUid, viewerUid);
      // The viewer may remove their own access record during account deletion.
      allow delete: if isSelf(ownerUid) || isSelf(viewerUid);
    }

    // Homi stores only the latest shared location/battery snapshot here.
    // Movement history is deliberately not enabled by default.
    match /locations/{ownerUid} {
      allow create, update: if isSelf(ownerUid)
        && validLocationSnapshot(request.resource.data);
      allow delete: if isSelf(ownerUid);
      allow read: if isSelf(ownerUid)
        || (signedIn() && hasActiveLocationShare(ownerUid, request.auth.uid));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
